/* Function arguments must match formal parameter types. */

test1:function integer (a:integer, b:integer);
test2:function boolean (a:integer, b:integer);

main: function integer () =
{
	x:integer = test2(5, 6);
	test2(5,6);
	print test2(11);
  return 0;
}

test2: function boolean (a:integer, b:integer) =
{
	return a==b;
}
