fill: function void (a: array [] integer, value: integer) = {
	i: integer;
	for (i = 0; i < #a; i++) a[i] = value + i;
}

main: function integer () = {
	a: array [4] integer;
	fill(a, 10);
	print a[0], " ", a[3], " ", #a, "\n";

	m: array [2] array [3] integer;
	m[1][2] = 7;
	print m[0][0], " ", m[1][2], " ", #m, " ", #m[1], "\n";

	b: array [3] boolean = {true, false, true};
	print b[0], " ", b[1], " ", b[2], "\n";

	n: array [2] array [2] char = {{'a', 'b'}, {'c', 'd'}};
	print n[0][1], n[1][0], "\n";

	c: carray [3] integer = {5, 6, 7};
	c[2]++;
	print c[0] + c[2], "\n";

	k: integer = 3;
	v: array [k] string;
	v[k - 1] = "last";
	print v[2], "\n";
	return 0;
}
