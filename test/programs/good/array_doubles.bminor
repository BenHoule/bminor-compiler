// Doubles are stored as raw 8-byte words, so arrays need no float-specific code.
scale: function void (a: array [] double, k: double) = {
	i: integer;
	for (i = 0; i < #a; i++) a[i] = a[i] * k;
}

total: function double (a: array [] double) = {
	sum: double = 0.0;
	i: integer;
	for (i = 0; i < #a; i++) sum = sum + a[i];
	return sum;
}

row_lengths: function integer (m: array [] array [] double) = {
	return #m * 10 + #m[0];
}

main: function integer () = {
	v: array [3] double = {1.5, -2.25, 4.0};
	scale(v, 2.0);
	print v[0], " ", v[1], " ", v[2], " ", total(v), "\n";

	m: array [2] array [4] double;
	m[1][3] = 0.5;
	m[0][0] = -m[1][3];
	print m[0][0], " ", m[1][3], " ", m[1][0], " ", row_lengths(m), "\n";
	return 0;
}
