factorial: function integer (n: integer) = {
	if (n <= 1) return 1;
	return n * factorial(n - 1);
}

even: function boolean (n: integer);

odd: function boolean (n: integer) = {
	if (n == 0) return false;
	return even(n - 1);
}

even: function boolean (n: integer) = {
	if (n == 0) return true;
	return odd(n - 1);
}
